{
  "extends": "expo-module-scripts/tsconfig.plugin",
  "compilerOptions": {
    "outDir": "build",
    // The package root rather than `src`: the plugin also compiles `../src/iosDocumentTypes.ts`,
    // which it shares with the module. That nests the output under `build/plugin/src`.
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*"]
}
